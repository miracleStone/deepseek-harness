{
  "name": "@local/dsh-session-fast",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Per-session Codex Fast switch with durable preferences and explicit Standard requests when disabled.",
  "license": "MIT",
  "engines": { "dsh": "0.2.2-alpha.2" },
