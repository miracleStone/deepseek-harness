  },
  "exports": { ".": "./host-v1.0.4.js", "./client": "./client-v1.0.4.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.png" },
  "files": ["index.js", "host-v1.0.4.js", "api.js", "adapter.js", "preferences.js", "client.js", "client-v1.0.4.js", "cordis.patch.yml", "locale/*.json", "icon.png", "README.md"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.7-alpha.1",
