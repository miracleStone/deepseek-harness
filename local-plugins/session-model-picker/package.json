{
  "name": "@local/dsh-session-model-picker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Extends the existing model and reasoning menu with session option rows.",
  "license": "MIT",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "index.js",
    "locale/en.json",
    "locale/zh.json",
    "README.md",
    "README.zh.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
